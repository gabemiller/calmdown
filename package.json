{
  "name": "calmdown",
  "description": "Lightweight markdown editor",
  "version": "0.6.2",
  "keywords": [
    "markdown",
    "markdowneditor",
    "editor",
    "wysiwyg",
    "showdown",
    "syntaxhightlight"
  ],
  "author": "Gabor Molnar <gabormolnar92@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/js/calmdown.min.js",
  "module": "dist/js/calmdown.min.mjs",
  "exports": {
    ".": {
      "import": "./dist/js/calmdown.min.mjs",
      "require": "./dist/js/calmdown.min.js"
    },
    "./css": "./dist/css/calmdown.min.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "vite": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabemiller/calmdown.git"
  },
  "bugs": {
    "url": "https://github.com/gabemiller/calmdown/issues"
  },
  "homepage": "https://github.com/gabemiller/calmdown#readme",
  "dependencies": {
    "mousetrap": "1.6.1",
    "normalize.css": "8.0.0",
    "prismjs": "1.14.0",
    "showdown": "1.8.6"
  }
}